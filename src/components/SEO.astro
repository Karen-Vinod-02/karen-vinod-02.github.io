---
interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  pubDate?: string;
}

const {
  title,
  description = "Computer Engineering student working across machine learning, AI systems, and applied research.",
  image = "/profile.png",
  article = false,
  pubDate,
} = Astro.props;

const siteUrl = Astro.site || 'https://karen-vinod-02.github.io';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const socialImageURL = new URL(image, siteUrl);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.ico`} />
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />

<meta property="og:site_name" content="Karen Marlyn Vinod" />
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:image:alt" content={`Visual card preview for: ${title}`} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:site" content="@KarenVinod02" />
<meta name="twitter:creator" content="@KarenVinod02" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL} />

{article && (
  <>
    {pubDate && <meta property="article:published_time" content={pubDate} />}
    <meta property="article:author" content="Karen Marlyn Vinod" />
    <meta property="article:section" content="Computer Engineering" />
  </>
)}