---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { 
      entry: post,
      prev: index > 0 ? posts[index - 1] : null,
      next: index < posts.length - 1 ? posts[index + 1] : null
    },
  }));
});

interface Props {
  entry: CollectionEntry<'blog'>;
  prev: CollectionEntry<'blog'> | null;
  next: CollectionEntry<'blog'> | null;
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);

const postData = entry.data;

const wordCount = entry.body ? entry.body.split(/\s+/g).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const hasBibliography = postData.bibliography && postData.bibliography.length > 0;

const rawBodyText = entry.body || '';
const needsMermaid = rawBodyText.includes('language-mermaid') || rawBodyText.includes('pre.mermaid') || !!postData.mermaid?.enabled;
const needsPlotly = rawBodyText.includes('language-plotly');
---

<Layout 
  title={`${postData.title} - Karen Vinod`}
  description={postData.excerpt}
  image={postData.ogImage ?? '/og-default.jpg'}
  article={true}
  pubDate={postData.date.toISOString()}
>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFas967V2qE" crossorigin="anonymous" />

  <!-- Progress bar: lives OUTSIDE the grid wrapper so it can never be clipped -->
  <div id="reading-progress-bar" class="top-progress-indicator" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>

  <!--
    Mobile TOC: toggle button sits INSIDE the article flow (above the title).
  -->
  {headings.length > 0 && (
    <button id="toc-mobile-toggle" class="toc-mobile-btn" aria-label="Open table of contents" aria-expanded="false">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="15" y2="12"/>
        <line x1="3" y1="18" x2="18" y2="18"/>
      </svg>
      Contents
    </button>
  )}

  <div id="toc-overlay-backdrop" class="toc-backdrop" aria-hidden="true"></div>

  <div class="toc-drawer" id="toc-drawer" role="dialog" aria-modal="true" aria-label="Table of contents">
    <div class="toc-drawer-header">
      <span class="toc-drawer-title">Contents</span>
      <button id="toc-close-btn" class="toc-close-btn" aria-label="Close table of contents">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    {headings.length > 0 && (
      <div class="toc-drawer-scroll">
        <ul class="toc-list" aria-label="Table of contents">
          {headings.filter(h => h.depth <= 3).map(h => (
            <li class={`toc-item depth-${h.depth}`} data-heading-id={h.slug}>
              <a href={`#${h.slug}`} data-toc-link class="toc-anchor-link">
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <!-- Main two-column layout -->
  <div class="academic-blog-wrapper">

    <!-- Desktop-only sticky sidebar TOC (hidden on mobile via CSS) -->
    <aside class="academic-toc-column" aria-label="Table of contents sidebar" aria-hidden="true">
      {headings.length > 0 && (
        <nav class="toc-sticky-box" aria-label="Article headings">
          <p class="toc-headline" id="toc-sidebar-heading">Contents</p>
          <div class="toc-track-container">
            <ul class="toc-list" aria-labelledby="toc-sidebar-heading">
              {headings.filter(h => h.depth <= 3).map(h => (
                <li class={`toc-item depth-${h.depth}`} data-heading-id={h.slug}>
                  <a href={`#${h.slug}`} data-toc-link class="toc-anchor-link">
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </nav>
      )}
    </aside>

    <article class="post-core-container">
      <header class="post-header-block">
        <h1 class="entry-title">{postData.title}</h1>
        
        <div class="entry-meta-strip" aria-label="Post metadata">
          <div class="meta-cell">
            <span class="cell-label">Published</span>
            <time datetime={postData.date.toISOString()}>
              {postData.date.toISOString().split('T')[0]}
            </time>
          </div>
          <div class="meta-cell">
            <span class="cell-label">Reading Time</span>
            <span class="meta-value-text">{readingTime} min read</span>
          </div>
          <div class="meta-cell">
            <span class="cell-label">Topics</span>
            <div class="tag-row">
              {postData.tags.map(tag => (
                <span class="hash-tag">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      </header>

      <div class="post-body-content">
        <Content />
      </div>

      {hasBibliography && postData.bibliography && (
        <section class="bibliography-section" id="bibliography">
          <h2>References</h2>
          <ol class="bibliography-list">
            {postData.bibliography.map((ref: string, index: number) => (
              <li id={`ref-${index + 1}`} class="bibliography-item">
                <span class="bib-number">[{index + 1}]</span>
                <span class="bib-content">{ref}</span>
              </li>
            ))}
          </ol>
        </section>
      )}

      <footer class="post-navigation-footer">
        <div class="footer-meta-row">
          <span class="license-info">Licensed under <strong>CC BY 4.0</strong> by the author.</span>
          <div class="share-actions-group">
            <span class="share-label">SHARE:</span>
            <button id="copy-btn" class="share-icon-btn" aria-label="Copy link">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
            </button>
            <a href={`https://x.com/intent/tweet?text=${encodeURIComponent(postData.title)}&url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener" class="share-icon-btn" aria-label="Share on X">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
            </a>
            <a href={`https://bsky.app/intent/compose?text=${encodeURIComponent(postData.title + ' ' + Astro.url.href)}`} target="_blank" rel="noopener" class="share-icon-btn" aria-label="Share on Bluesky">
              <svg viewBox="0 0 568 501" width="16" height="16" fill="currentColor"><path d="M123.121 33.664C188.241 82.553 258.281 181.68 284 234.873c25.719-53.192 95.759-152.32 160.879-201.209C491.866-1.611 568-28.906 568 57.947c0 17.346-9.945 145.713-15.778 166.555-20.275 72.453-94.155 90.933-159.875 79.748C507.222 323.8 536.444 388.56 473.922 453.32c-119.86 122.992-172.935-30.859-186.181-70.467-2.362-6.953-3.46-10.183-3.741-10.183-.281 0-1.379 3.23-3.741 10.183-13.246 39.608-66.321 193.459-186.181 70.467C31.556 388.56 60.778 323.8 175.653 304.25c-65.72 11.185-139.6-7.295-159.875-79.748C9.945 203.66 0 75.293 0 57.947 0-28.906 76.134-1.611 123.121 33.664z"/></svg>
            </a>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener" class="share-icon-btn" aria-label="Share on LinkedIn">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a href="/rss.xml" class="share-icon-btn" aria-label="RSS Feed">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
            </a>
            <a href="/feed.json" class="share-icon-btn" aria-label="JSON Feed">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 12h.01M12 12h.01M16 12h.01"/></svg>
            </a>
          </div>
        </div>
        <nav class="context-navigation"></nav>
      </footer>
    </article>
  </div>
</Layout>

{needsMermaid && <script type="text/javascript" id="Mermaid-script" async src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>}
{needsPlotly && <script type="text/javascript" id="Plotly-script" async src="https://cdn.jsdelivr.net/npm/plotly.js-dist-min@2.27.0/plotly.min.js" charset="utf-8"></script>}

<script define:vars={{ needsMermaid, needsPlotly }}>
  function checkAssetAvailability(globalProperty, callback) {
    if (window[globalProperty]) { callback(); return; }
    let attempts = 0;
    const interval = setInterval(() => {
      if (window[globalProperty]) { clearInterval(interval); callback(); }
      else if (++attempts >= 80) { clearInterval(interval); console.warn(`[Asset Subsystem] timeout: ${globalProperty}`); }
    }, 50);
  }

  function initializeMermaidDiagrams() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    document.querySelectorAll('pre code.language-mermaid').forEach((codeBlock) => {
      const pre = codeBlock.parentElement;
      if (!pre) return;
      const wrapper = document.createElement('div');
      wrapper.className = 'diagram-wrapper';
      const container = document.createElement('div');
      container.className = 'mermaid-diagram';
      container.textContent = codeBlock.textContent;
      wrapper.appendChild(container);
      pre.replaceWith(wrapper);
    });
    document.querySelectorAll('pre.mermaid').forEach((pre) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'diagram-wrapper';
      const container = document.createElement('div');
      container.className = 'mermaid-diagram';
      container.textContent = pre.textContent;
      wrapper.appendChild(container);
      pre.replaceWith(wrapper);
    });
    window.mermaid.initialize({ startOnLoad: false, theme: isDark ? 'dark' : 'neutral', securityLevel: 'strict', fontFamily: 'var(--font-body)' });
    window.mermaid.run({ querySelector: '.mermaid-diagram' });
  }

  function initializePlotlyCharts() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    document.querySelectorAll('pre code.language-plotly').forEach((codeBlock) => {
      const pre = codeBlock.parentElement;
      if (!pre) return;
      try {
        const plotData = JSON.parse(codeBlock.textContent || '{}');
        const wrapper = document.createElement('div');
        wrapper.className = 'chart-wrapper';
        const plotDiv = document.createElement('div');
        plotDiv.className = 'plotly-chart';
        const layout = {
          ...plotData.layout,
          font: { family: 'var(--font-body)', color: isDark ? '#e5e7eb' : '#374151' },
          paper_bgcolor: 'transparent', plot_bgcolor: 'transparent',
          xaxis: { ...plotData.layout?.xaxis, gridcolor: isDark ? '#374151' : '#e5e7eb' },
          yaxis: { ...plotData.layout?.yaxis, gridcolor: isDark ? '#374151' : '#e5e7eb' }
        };
        wrapper.appendChild(plotDiv);
        pre.replaceWith(wrapper);
        window.Plotly.newPlot(plotDiv, plotData.data, layout, { responsive: true, displayModeBar: false });
      } catch (e) { console.error('Plotly parse error:', e); }
    });
  }

  function addCopyButtons() {
    document.querySelectorAll('.post-body-content pre').forEach(pre => {
      if (pre.querySelector('.code-block-header') || pre.closest('.diagram-wrapper, .chart-wrapper')) return;
      const codeBlock = pre.querySelector('code');
      if (!codeBlock) return;
      const className = codeBlock.className || '';
      const preClassName = pre.className || '';
      const rawText = codeBlock.textContent || '';
      const normalText = rawText.trim();
      if (className.includes('mermaid') || preClassName.includes('mermaid') ||
          className.includes('plotly') || preClassName.includes('plotly') ||
          normalText.startsWith('graph ') || normalText.startsWith('sequenceDiagram') ||
          normalText.startsWith('gantt ') || normalText.startsWith('classDiagram')) return;
      let language = 'text';
      const attrLang = codeBlock.getAttribute('data-language') || pre.getAttribute('data-language');
      if (attrLang) {
        language = attrLang;
      } else {
        const fullClass = `${className} ${preClassName}`.toLowerCase();
        const m = fullClass.match(/shiki-(\w+)/) || fullClass.match(/language-(\w+)/);
        if (m) language = m[1];
        else if (preClassName.includes('astro-code')) language = 'code';
      }
      const mappedLanguage = language.charAt(0).toUpperCase() + language.slice(1);
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-container';
      const header = document.createElement('div');
      header.className = 'code-block-header';
      const dotsGroup = document.createElement('div');
      dotsGroup.className = 'code-header-dots';
      dotsGroup.innerHTML = '<span></span><span></span><span></span>';
      const langLabel = document.createElement('div');
      langLabel.className = 'code-language-label';
      langLabel.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg> <span>${mappedLanguage}</span>`;
      const copyBtn = document.createElement('button');
      copyBtn.className = 'copy-code-btn';
      copyBtn.setAttribute('aria-label', 'Copy code to clipboard');
      copyBtn.innerHTML = `<svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" /></svg>`;
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(rawText);
          copyBtn.innerHTML = `<svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
          copyBtn.classList.add('copied');
          setTimeout(() => {
            copyBtn.innerHTML = `<svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" /></svg>`;
            copyBtn.classList.remove('copied');
          }, 2000);
        } catch {
          copyBtn.classList.add('failed');
          setTimeout(() => copyBtn.classList.remove('failed'), 2000);
        }
      });
      header.appendChild(dotsGroup);
      header.appendChild(langLabel);
      header.appendChild(copyBtn);
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(header);
      wrapper.appendChild(pre);
    });
  }

  function processCitations() {
    const content = document.querySelector('.post-body-content');
    if (!content) return;
    const walker = document.createTreeWalker(content, NodeFilter.SHOW_TEXT, {
      acceptNode: (node) => {
        if (node.parentElement?.closest('pre, code, .citation-link, a')) return NodeFilter.FILTER_REJECT;
        return /\[\d+\]/.test(node.textContent || '') ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
      }
    });
    const nodesToProcess = [];
    let node;
    while (node = walker.nextNode()) {
      const matches = Array.from((node.textContent || '').matchAll(/\[(\d+)\]/g));
      if (matches.length > 0) nodesToProcess.push({ node, matches });
    }
    nodesToProcess.reverse().forEach(({ node, matches }) => {
      const text = node.textContent || '';
      const parent = node.parentNode;
      if (!parent) return;
      let lastIndex = 0;
      const fragment = document.createDocumentFragment();
      matches.forEach(match => {
        const index = match.index;
        const citationNum = match[1];
        if (index !== undefined && index > lastIndex) fragment.appendChild(document.createTextNode(text.slice(lastIndex, index)));
        const link = document.createElement('a');
        link.href = `#ref-${citationNum}`;
        link.className = 'citation-link';
        link.textContent = `[${citationNum}]`;
        link.setAttribute('aria-label', `Reference ${citationNum}`);
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const target = document.getElementById(`ref-${citationNum}`);
          if (target) {
            window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - 100, behavior: 'smooth' });
            target.classList.add('highlight-ref');
            setTimeout(() => target.classList.remove('highlight-ref'), 2500);
          }
        });
        fragment.appendChild(link);
        if (index !== undefined) lastIndex = index + match[0].length;
      });
      if (lastIndex < text.length) fragment.appendChild(document.createTextNode(text.slice(lastIndex)));
      parent.replaceChild(fragment, node);
    });
  }

  function runContentPipeline() {
    if (needsMermaid) checkAssetAvailability('mermaid', initializeMermaidDiagrams);
    if (needsPlotly) checkAssetAvailability('Plotly', initializePlotlyCharts);
    addCopyButtons();
    processCitations();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runContentPipeline);
  } else {
    runContentPipeline();
  }
</script>

<script>
  import { initializeTOC } from '../../lib/toc/index';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => { initializeTOC(); });
  } else {
    initializeTOC();
  }

  function updateProgressBar() {
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;
    const el = document.scrollingElement || document.documentElement;
    const scrollable = el.scrollHeight - el.clientHeight;
    const pct = scrollable > 0 ? (el.scrollTop / scrollable) * 100 : 0;
    bar.style.width = `${Math.min(100, Math.max(0, pct))}%`;
    bar.setAttribute('aria-valuenow', String(Math.round(pct)));
  }
  window.addEventListener('scroll', updateProgressBar, { passive: true });
  updateProgressBar();

  const tocToggle   = document.getElementById('toc-mobile-toggle');
  const tocDrawer   = document.getElementById('toc-drawer');
  const tocClose    = document.getElementById('toc-close-btn');
  const tocBackdrop = document.getElementById('toc-overlay-backdrop');

  function openTOC() {
    tocDrawer?.classList.add('is-open');
    tocBackdrop?.classList.add('is-visible');
    tocToggle?.setAttribute('aria-expanded', 'true');
    tocToggle?.classList.add('is-hidden');
    document.body.style.overflow = 'hidden';
    tocClose?.focus();
  }
  function closeTOC() {
    tocDrawer?.classList.remove('is-open');
    tocBackdrop?.classList.remove('is-visible');
    tocToggle?.setAttribute('aria-expanded', 'false');
    tocToggle?.classList.remove('is-hidden');
    document.body.style.overflow = '';
    tocToggle?.focus();
  }

  tocToggle?.addEventListener('click', openTOC);
  tocClose?.addEventListener('click', closeTOC);
  tocBackdrop?.addEventListener('click', closeTOC);

  tocDrawer?.querySelectorAll('[data-toc-link]').forEach(link => {
    link.addEventListener('click', () => { if (window.innerWidth < 960) closeTOC(); });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && tocDrawer?.classList.contains('is-open')) closeTOC();
  });

  document.getElementById('copy-btn')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const orig = btn.innerHTML;
    try {
      await navigator.clipboard.writeText(window.location.href);
      btn.innerHTML = `<svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" width="16" height="16"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
      btn.classList.add('copied');
      setTimeout(() => { btn.innerHTML = orig; btn.classList.remove('copied'); }, 2000);
    } catch {}
  });
</script>

<style is:global>
  .top-progress-indicator {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0%;
    background: var(--link);
    z-index: 9999;
    pointer-events: none;
    transition: width 0.08s linear;
  }

  .toc-mobile-btn {
    /* Hidden on desktop */
    display: none;
    position: fixed; /* persists throughout the entire post */
    bottom: max(1.25rem, env(safe-area-inset-bottom, 1.25rem));
    left: max(1rem, env(safe-area-inset-left, 1rem));
    z-index: 300;
    align-items: center;
    gap: 0.45rem;
    background: var(--bg, #fff);
    border: 1px solid var(--border, #e4e4e7);
    color: var(--text-light);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.5rem 0.9rem 0.5rem 0.75rem;
    border-radius: 999px;
    cursor: pointer;
    min-height: 36px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1), 0 0 0 1px var(--border);
    -webkit-tap-highlight-color: transparent;
    transition: color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .toc-mobile-btn:hover,
  .toc-mobile-btn:focus-visible {
    color: var(--text);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.14), 0 0 0 1px var(--text);
    transform: translateY(-1px);
  }
  .toc-mobile-btn:active { transform: translateY(0); }
  /* Hide FAB while drawer is open */
  .toc-mobile-btn.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(6px);
  }

  @media (max-width: 959px) {
    .toc-mobile-btn { display: inline-flex; }
  }

  .toc-backdrop {
    position: fixed;
